<?xml version="1.0"?>
<JWM>
    <!-- Categorized Start Menu -->
    <RootMenu onroot="12">
        <Program label="App Store (PocketStore)" icon="system-software-install">pocketlinux-store.py</Program>
        <Program label="Download Manager" icon="folder-download">pocketlinux-downloads.py</Program>
        <Program label="Settings &amp; Personalization" icon="preferences-system">pocketlinux-settings.py</Program>
        <Separator/>
        <Menu label="Installed Apps" icon="applications-other">
            <Include>/root/.jwmrc-apps</Include>
        </Menu>
        <Separator/>
        <Program label="Terminal" icon="utilities-terminal">xterm -fa "DejaVu Sans Mono" -fs 12 -bg "#0F172A" -fg "#E2E8F0"</Program>
        <Program label="File Manager" icon="system-file-manager">pcmanfm /root</Program>
        <Program label="Applications Folder" icon="folder">pcmanfm /root/Applications</Program>
        <Separator/>
        <Menu label="Accessories" icon="applications-accessories">
            <Program label="Text Editor (Mousepad)" icon="accessories-text-editor">mousepad</Program>
            <Program label="Terminal Editor (nano)" icon="accessories-text-editor">xterm -T "nano" -fa "DejaVu Sans Mono" -fs 12 -bg "#0F172A" -fg "#E2E8F0" -e nano</Program>
            <Program label="Calculator (Galculator)" icon="accessories-calculator">galculator</Program>
            <Program label="Calculator (xcalc)" icon="accessories-calculator">xcalc</Program>
            <Program label="Clock (xclock)" icon="appointment-soon">xclock</Program>
        </Menu>
        <Menu label="Graphics" icon="applications-graphics">
            <Program label="Image Viewer (feh)" icon="image-x-generic">feh /usr/share/backgrounds/pocketlinux-wallpaper.png</Program>
        </Menu>
        <Menu label="System" icon="applications-system">
            <Program label="Settings &amp; GPU Control" icon="preferences-system">pocketlinux-settings.py</Program>
            <Program label="App Store (PocketStore)" icon="system-software-install">pocketlinux-store.py</Program>
            <Program label="Download Manager" icon="folder-download">pocketlinux-downloads.py</Program>
            <Program label="Sync Installed Apps" icon="view-refresh">pocketlinux-sync-apps.py</Program>
            <Program label="System Health &amp; ELF Check" icon="utilities-system-monitor">xterm -T "PocketLinux Health Check" -fa "DejaVu Sans Mono" -fs 11 -bg "#0F172A" -fg "#E2E8F0" -hold -e /usr/local/bin/linux-health.sh</Program>
            <Program label="Process Monitor (htop)" icon="utilities-system-monitor">xterm -T "htop" -fa "DejaVu Sans Mono" -fs 11 -bg "#0F172A" -fg "#E2E8F0" -e htop</Program>
            <Program label="System Info (sysinfo)" icon="dialog-information">xterm -T "System Info" -fa "DejaVu Sans Mono" -fs 11 -bg "#0F172A" -fg "#E2E8F0" -hold -e /usr/local/bin/sysinfo.sh --text</Program>
        </Menu>
        <Separator/>
        <Restart label="Restart JWM" icon="view-refresh"/>
        <Exit label="Exit Desktop" confirm="false" icon="application-exit"/>
    </RootMenu>

    <!-- Keep PocketLinux interactive desktop canvas always beneath all windows -->
    <Group>
        <Class>PocketLinuxDesktop</Class>
        <Option>layer:below</Option>
        <Option>noborder</Option>
        <Option>notitle</Option>
        <Option>nolist</Option>
        <Option>nopager</Option>
        <Option>sticky</Option>
        <Option>fixed</Option>
    </Group>

    <!-- Live customizable Taskbar, Accent Theme, Workspaces & Window Behavior -->
    <Include>/root/.jwmrc-theme</Include>

    <StartupCommand>xsetroot -cursor_name left_ptr</StartupCommand>
    <FocusModel>click</FocusModel>

    <Key mask="A" key="Tab">nextstacked</Key>
    <Key mask="A" key="F4">close</Key>
    <Key mask="A" key="F1">root:1</Key>
</JWM>
