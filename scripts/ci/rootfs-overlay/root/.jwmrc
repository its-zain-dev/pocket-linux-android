<?xml version="1.0"?>
<JWM>
    <RootMenu onroot="12">
        <Program label="Terminal (xterm)" icon="utilities-terminal">xterm -fa "DejaVu Sans Mono" -fs 11</Program>
        <Program label="Text Editor (Mousepad)" icon="accessories-text-editor">mousepad</Program>
        <Program label="File Manager (PCManFM)" icon="system-file-manager">pcmanfm</Program>
        <Program label="Calculator (Galculator)" icon="accessories-calculator">galculator</Program>
        <Program label="Calculator (xcalc)" icon="accessories-calculator">xcalc</Program>
        <Program label="Clock (xclock)" icon="appointment-soon">xclock</Program>
        <Program label="Image Viewer (feh)" icon="image-x-generic">feh</Program>
        <Separator/>
        <Restart label="Restart JWM" icon="view-refresh"/>
        <Exit label="Exit" confirm="false" icon="application-exit"/>
    </RootMenu>

    <Tray x="0" y="-1" height="32" autohide="off" halign="fixed" valign="bottom">
        <TrayButton label="Apps">root:1</TrayButton>
        <TrayButton label="Term">exec:xterm -fa "DejaVu Sans Mono" -fs 11</TrayButton>
        <Pager labeled="true"/>
        <TaskList maxwidth="200"/>
        <Dock/>
        <Clock format="%H:%M"/>
    </Tray>

    <WindowStyle>
        <Font>DejaVu Sans-10:bold</Font>
        <Width>4</Width>
        <Height>24</Height>
        <Corner>4</Corner>
        <Foreground>#E2E8F0</Foreground>
        <Background>#1E293B</Background>
        <Outline>#334155</Outline>
        <Opacity>1.0</Opacity>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#0284C7</Background>
            <Outline>#38BDF8</Outline>
            <Opacity>1.0</Opacity>
        </Active>
    </WindowStyle>

    <TrayStyle group="true" list="all">
        <Font>DejaVu Sans-10</Font>
        <Background>#0F172A</Background>
        <Foreground>#E2E8F0</Foreground>
        <Outline>#334155</Outline>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#0369A1</Background>
        </Active>
    </TrayStyle>

    <TaskListStyle>
        <Font>DejaVu Sans-10</Font>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#0284C7</Background>
        </Active>
        <Foreground>#CBD5E1</Foreground>
        <Background>#1E293B</Background>
    </TaskListStyle>

    <PagerStyle>
        <Outline>#334155</Outline>
        <Foreground>#38BDF8</Foreground>
        <Background>#0F172A</Background>
        <Text>#E2E8F0</Text>
        <Active>
            <Foreground>#0284C7</Foreground>
            <Background>#1E293B</Background>
        </Active>
    </PagerStyle>

    <MenuStyle>
        <Font>DejaVu Sans-10</Font>
        <Foreground>#E2E8F0</Foreground>
        <Background>#0F172A</Background>
        <Outline>#334155</Outline>
        <Active>
            <Foreground>#FFFFFF</Foreground>
            <Background>#0284C7</Background>
        </Active>
    </MenuStyle>

    <ClockStyle>
        <Font>DejaVu Sans-10:bold</Font>
        <Foreground>#38BDF8</Foreground>
        <Background>#0F172A</Background>
    </ClockStyle>

    <Desktops width="2" height="1">
        <Background type="solid">#1E293B</Background>
    </Desktops>

    <StartupCommand>xsetroot -solid "#1E293B" -cursor_name left_ptr</StartupCommand>

    <DoubleClickSpeed>400</DoubleClickSpeed>
    <DoubleClickDelta>2</DoubleClickDelta>
    <FocusModel>click</FocusModel>
    <SnapMode distance="10">border</SnapMode>
    <MoveMode>opaque</MoveMode>
    <ResizeMode>opaque</ResizeMode>

    <Key mask="A" key="Tab">nextstacked</Key>
    <Key mask="A" key="F4">close</Key>
    <Key mask="A" key="F1">root:1</Key>
</JWM>
